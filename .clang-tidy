# Curated check set: only families/checks with proven value for this codebase.
# The compiler already enforces correctness (-Wconversion -Wshadow -Wpedantic
# -Werror) and .clang-format owns style, so style-only families (readability-*,
# modernize-*) are not enabled here. Exclusions below are genuine
# false-positive sources and must come AFTER the enable globs (last match wins).
# The internal linkage one gets fucked by modules...
Checks: >
  -*,
  bugprone-*,
  performance-*,
  misc-*,
  -bugprone-easily-swappable-parameters,
  -performance-noexcept-move-constructor,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-internal-linkage,
HeaderFilterRegex: 'PixelForge'
ExcludeHeaderFilterRegex: '.*/(extern|build)/.*'
FormatStyle: file
